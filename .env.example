APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=stdout,single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=filament
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
QUEUE_CONNECTION=database
CACHE_STORE=file
FILESYSTEM_DISK=minio

# MinIO / Object Storage Configuration
MINIO_KEY=minioadmin
MINIO_SECRET=minioadmin
MINIO_REGION=us-east-1
MINIO_BUCKET=project
MINIO_ROOT=blog
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_URL=http://127.0.0.1:9000/project
MINIO_USE_PATH_STYLE_ENDPOINT=true

# AWS S3 Fallbacks (optional)
AWS_ACCESS_KEY_ID=${MINIO_KEY}
AWS_SECRET_ACCESS_KEY=${MINIO_SECRET}
AWS_DEFAULT_REGION=${MINIO_REGION}
AWS_BUCKET=${MINIO_BUCKET}
AWS_ENDPOINT=${MINIO_ENDPOINT}
AWS_URL=${MINIO_URL}
AWS_USE_PATH_STYLE_ENDPOINT=true

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google-callback"

# Apple OAuth & Server-to-Server Webhook
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_REDIRECT_URI="${APP_URL}/auth/apple-callback"
APPLE_KEY_ID=
APPLE_TEAM_ID=
APPLE_PRIVATE_KEY=

# Resend Mail Configuration
RESEND_KEY=
MAIL_MAILER=resend
MAIL_FROM_ADDRESS="no-reply@eka-dev.cloud"
MAIL_FROM_NAME="${APP_NAME}"

# News & External Content API (Optional - defaults to zero-config Dev.to API)
NEWS_API_KEY=
NEWS_API_CATEGORY=technology
NEWS_API_LANGUAGE=en

VITE_APP_NAME="${APP_NAME}"
